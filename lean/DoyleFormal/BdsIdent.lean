import DoyleFormal.BdsClass

/-!
# `D_B` is the spiral `P_𝔄` of Beardon–Dubejko–Stephenson (paper A, Theorem 7.5)

Beardon, Dubejko and Stephenson (Geom. Dedicata 49 (1994), §4) parametrize the spiral packings
by `𝔄 ∈ ℂ` with (their condition (11)) `0 ≤ arg 𝔄 ≤ π/6`, `|𝔄| > 2√3/sin(2π/3 − arg 𝔄)`.
For such `𝔄` their Lemma 3 gives a unique pair `(μ, ν) ∈ ℝ × (0, ∞)` such that, with the shear
`Φ(x + iy) = x + i(μx + νy)` and the `ℝ`-linear map `Λ(z) = 2πi Φ(|𝔄| z/𝔄)/Φ(|𝔄|)`,
* `Im Λ(w_j) ∈ [0, π)` for `w₁ = 1 − √3 i`, `w₂ = 2`, `w₃ = 1 + √3 i`, and
* `z_j = exp Λ(w_j)` are the vertices of a quadrilateral `1, z₁, z₂, z₃` associated with cell
  continuation (radii with `R₀R₂ = R₁R₃`, their (5)–(7)) and normalized by their (3) and (8).

`P_𝔄` is the packing generated by this quadrilateral; its centers are `exp Λ(H)`,
`H = ℤw₁ + ℤw₃`.

Here, for `B > 1`, `t = π/ψ(B)`, `𝔄 = t(3 + √3 i)`, `μ = 0` and `ν = √3 log B/ψ`:
* `bds_admissible`: `𝔄` satisfies (11) (`arg 𝔄 = π/6`, `|𝔄| = 2√3 t > 2√3`);
* `bds_lemma3`: `(0, ν)` has every property of BDS Lemma 3;
* `lambda_kappa`, `center_eq_bdsE`, `rad_eq_norm_bdsE`: with the lattice isomorphism
  `κ(p,q) = e^{−iπ/3} ι(p,q) = (p + q)w₁ + q w₃` of `ℤ²` onto `H`, the circle `K(p,q)` of `D_B`,
  moved by the similarity `z ↦ (z − X)/(−X)`, has center `exp Λ(κ(p,q))` and radius
  `|exp Λ(κ(p,q))|/|X|`;
* `bdsLambda_self`, `bdsE_period`: `Λ(𝔄) = 2πi`, so `exp Λ` has period `𝔄`.

Hence `D_B` is, up to similarity, the packing generated by the quadrilateral `Q_𝔄` built from
the pair `(0, ν)`. That this pair is *the* pair of BDS Lemma 3, and so `D_B = P_𝔄`, is the
uniqueness statement of their Lemma 3, which is not formalized here.
-/

namespace DoyleFormal

open Complex

/-! ### The construction of Beardon–Dubejko–Stephenson, §4 -/

/-- The shear `Φ(x + iy) = x + i(μx + νy)`. -/
def bdsPhi (μ ν : ℝ) (z : ℂ) : ℂ := ⟨z.re, μ * z.re + ν * z.im⟩

/-- `Λ(z) = 2πi Φ(|𝔄| z/𝔄)/Φ(|𝔄|)` (BDS (10)). -/
noncomputable def bdsLambda (A : ℂ) (μ ν : ℝ) (z : ℂ) : ℂ :=
  2 * Real.pi * I * bdsPhi μ ν ((‖A‖ : ℂ) * z / A) / bdsPhi μ ν (‖A‖ : ℂ)

/-- `E = exp ∘ Λ` (BDS (10)). -/
noncomputable def bdsE (A : ℂ) (μ ν : ℝ) (z : ℂ) : ℂ := exp (bdsLambda A μ ν z)

/-- The lattice `H = ℤw₁ + ℤw₃` of the regular hexagonal packing (BDS (9)). -/
def bdsH : Set ℂ := {h | ∃ a b : ℤ, h = a * w1 + b * w3}

/-- **Condition (11)** of BDS. -/
def BdsAdmissible (A : ℂ) : Prop :=
  0 ≤ arg A ∧ arg A ≤ Real.pi / 6 ∧ 2 * √3 / Real.sin (2 * Real.pi / 3 - arg A) < ‖A‖

/-- The quadrilateral `1, z₁, z₂, z₃` is associated with cell continuation: the triangles
`(1, z₁, z₂)` and `(1, z₂, z₃)` are cells (centers of mutually tangent circles), sharing the
circles at `1` and `z₂`, and `R₀R₂ = R₁R₃` (BDS (5)–(7)). With the normalization (3) (fixed
point `ζ = 0` of the side-pairings `z ↦ z₁z`, `z ↦ z₃z`, which map circles to circles) the
radii are proportional to the moduli of the centers: `R_j = |z_j| R₀`. -/
def CellQuad (z₁ z₂ z₃ : ℂ) : Prop :=
  ∃ R₀ R₁ R₂ R₃ : ℝ, 0 < R₀ ∧ 0 < R₁ ∧ 0 < R₂ ∧ 0 < R₃ ∧
    ‖z₁ - 1‖ = R₁ + R₀ ∧ ‖z₂ - 1‖ = R₂ + R₀ ∧ ‖z₂ - z₁‖ = R₂ + R₁ ∧
    ‖z₃ - 1‖ = R₃ + R₀ ∧ ‖z₂ - z₃‖ = R₂ + R₃ ∧ R₀ * R₂ = R₁ * R₃ ∧
    R₁ = ‖z₁‖ * R₀ ∧ R₂ = ‖z₂‖ * R₀ ∧ R₃ = ‖z₃‖ * R₀

/-- **Normalizations (3) and (8)** of BDS: `z₂ = z₁z₃`, `|z₁| ≥ 1`, and
`|z₁| > 1`, `|z₂| ≥ 1`, `0 ≤ arg z₁ ≤ arg z₃ ≤ arg z₂ < π`, with `z₁, z₂, z₃` the centers of
successive petals of the flower about `1` in counterclockwise order. -/
def BdsNormalized (z₁ z₂ z₃ : ℂ) : Prop :=
  z₂ = z₁ * z₃ ∧ 1 ≤ ‖z₁‖ ∧ 1 < ‖z₁‖ ∧ 1 ≤ ‖z₂‖ ∧
    0 ≤ arg z₁ ∧ arg z₁ ≤ arg z₃ ∧ arg z₃ ≤ arg z₂ ∧ arg z₂ < Real.pi ∧
    0 < orient 1 z₁ z₂ ∧ 0 < orient 1 z₂ z₃

/-- **The properties of the pair `(μ, ν)` in BDS Lemma 3.** -/
def BdsLemma3 (A : ℂ) (μ ν : ℝ) : Prop :=
  0 < ν ∧
    (∀ w ∈ ({w1, 2, w3} : Set ℂ),
      0 ≤ (bdsLambda A μ ν w).im ∧ (bdsLambda A μ ν w).im < Real.pi) ∧
    CellQuad (bdsE A μ ν w1) (bdsE A μ ν 2) (bdsE A μ ν w3) ∧
    BdsNormalized (bdsE A μ ν w1) (bdsE A μ ν 2) (bdsE A μ ν w3)

lemma bdsPhi_add (μ ν : ℝ) (z w : ℂ) : bdsPhi μ ν (z + w) = bdsPhi μ ν z + bdsPhi μ ν w := by
  apply Complex.ext <;> simp [bdsPhi]
  ring

/-- `Λ` is additive. -/
theorem bdsLambda_add (A : ℂ) (μ ν : ℝ) (z w : ℂ) :
    bdsLambda A μ ν (z + w) = bdsLambda A μ ν z + bdsLambda A μ ν w := by
  unfold bdsLambda
  rw [mul_add, add_div, bdsPhi_add]
  ring

/-- **`Λ(𝔄) = 2πi`**: `𝔄` is a period of `E`. -/
theorem bdsLambda_self {A : ℂ} (hA : A ≠ 0) (μ ν : ℝ) : bdsLambda A μ ν A = 2 * Real.pi * I := by
  unfold bdsLambda
  have hn : (‖A‖ : ℂ) ≠ 0 := ofReal_ne_zero.2 (norm_ne_zero_iff.2 hA)
  have hΦ : bdsPhi μ ν (‖A‖ : ℂ) ≠ 0 := by
    intro h
    have := congrArg Complex.re h
    simp [bdsPhi, norm_ne_zero_iff.2 hA] at this
  rw [mul_div_cancel_right₀ _ hA, mul_div_assoc, div_self hΦ, mul_one]

/-- `E(h + 𝔄) = E(h)`. -/
theorem bdsE_period {A : ℂ} (hA : A ≠ 0) (μ ν : ℝ) (h : ℂ) : bdsE A μ ν (h + A) = bdsE A μ ν h := by
  unfold bdsE
  rw [bdsLambda_add, bdsLambda_self hA, exp_add,
    show 2 * (Real.pi : ℂ) * I = ((1 : ℤ) : ℂ) * (2 * Real.pi * I) by push_cast; ring,
    exp_int_mul_two_pi_mul_I, mul_one]

/-! ### The data of `D_B` -/

/-- `𝔄 = t(3 + √3 i)`, `t = π/ψ(B)`. -/
noncomputable def Abds (B : ℝ) : ℂ := ((Real.pi / psi B : ℝ) : ℂ) * ⟨3, √3⟩

/-- `ν = √3 log B/ψ(B)` (and `μ = 0`). -/
noncomputable def nuB (B : ℝ) : ℝ := √3 * Real.log B / psi B

/-- The lattice isomorphism `κ(p,q) = e^{−iπ/3} ι(p,q) = (p + 2q) − √3 p i`. -/
noncomputable def kappa (p q : ℤ) : ℂ := ⟨p + 2 * q, -(√3 * p)⟩

lemma kappa_eq (p q : ℤ) : kappa p q = ((p + q : ℤ) : ℂ) * w1 + (q : ℂ) * w3 := by
  apply Complex.ext <;> simp [kappa, w1, w3] <;> ring

/-- `κ = e^{−iπ/3} ι`. -/
theorem kappa_rot (p q : ℤ) : kappa p q = exp (-(Real.pi / 3 : ℝ) * I) * iota p q := by
  rw [exp_neg_pi_div_three]
  apply Complex.ext <;> simp [kappa, iota, w3]
  · ring_nf; rw [Real.sq_sqrt (by norm_num)]; ring
  · ring

/-- **`κ` maps `ℤ²` bijectively onto `H`.** -/
theorem kappa_bij (a b : ℤ) : ∃! u : ℤ × ℤ, kappa u.1 u.2 = a * w1 + b * w3 := by
  refine ⟨(a - b, b), ?_, ?_⟩
  · simp only [kappa_eq]; push_cast; ring
  · rintro ⟨p, q⟩ h
    simp only [kappa_eq] at h
    have h' : (((p + q - a : ℤ) : ℝ) : ℂ) * w1 + (((q - b : ℤ) : ℝ) : ℂ) * w3 = 0 := by
      push_cast; push_cast at h; linear_combination h
    obtain ⟨h1, h2⟩ := w_indep h'
    have e1 : p + q - a = 0 := by exact_mod_cast h1
    have e2 : q - b = 0 := by exact_mod_cast h2
    ext <;> simp <;> omega

theorem kappa_mem (p q : ℤ) : kappa p q ∈ bdsH := ⟨p + q, q, by rw [kappa_eq]⟩

theorem kappa_w : kappa 1 0 = w1 ∧ kappa 0 1 = 2 ∧ kappa (-1) 1 = w3 := by
  refine ⟨?_, ?_, ?_⟩ <;> apply Complex.ext <;> simp [kappa, w1, w3]
  norm_num

lemma norm_mk_three : ‖(⟨3, √3⟩ : ℂ)‖ = 2 * √3 := by
  rw [Complex.norm_def, normSq_mk, show (3 : ℝ) * 3 + √3 * √3 = (2 * √3) ^ 2 by
    nlinarith [sqrt3_sq], Real.sqrt_sq (by positivity)]

/-- Orientation is multiplied by `|α|²` under `z ↦ αz + γ`. -/
lemma orient_mul_add (α γ a b c : ℂ) :
    orient (α * a + γ) (α * b + γ) (α * c + γ) = ‖α‖ ^ 2 * orient a b c := by
  unfold orient
  have e : (starRingEnd ℂ) (α * b + γ - (α * a + γ)) * (α * c + γ - (α * a + γ)) =
      (((‖α‖ ^ 2 : ℝ)) : ℂ) * ((starRingEnd ℂ) (b - a) * (c - a)) := by
    rw [show α * b + γ - (α * a + γ) = α * (b - a) by ring,
      show α * c + γ - (α * a + γ) = α * (c - a) by ring, map_mul, Complex.sq_norm,
      normSq_eq_conj_mul_self]
    ring
  rw [e, im_ofReal_mul]

section DB

variable {B : ℝ} (hB : 1 < B)
include hB

lemma t_pos : 0 < Real.pi / psi B := div_pos Real.pi_pos (psi_mem_Ioo hB).1

lemma one_lt_t : 1 < Real.pi / psi B := by
  have h := psi_mem_Ioo hB
  rw [lt_div_iff₀ h.1]; linarith [h.2]

/-- `|𝔄| = 2√3 t`. -/
theorem norm_Abds : ‖Abds B‖ = 2 * √3 * (Real.pi / psi B) := by
  rw [Abds, norm_mul, norm_real, Real.norm_eq_abs, abs_of_pos (t_pos hB), norm_mk_three]
  ring

/-- `arg 𝔄 = π/6`. -/
theorem arg_Abds : arg (Abds B) = Real.pi / 6 := by
  rw [Abds, arg_real_mul _ (t_pos hB)]
  have e : (⟨3, √3⟩ : ℂ) = ((2 * √3 : ℝ) : ℂ) *
      (cos ((Real.pi / 6 : ℝ) : ℂ) + sin ((Real.pi / 6 : ℝ) : ℂ) * I) := by
    rw [← ofReal_cos, ← ofReal_sin, Real.cos_pi_div_six, Real.sin_pi_div_six]
    apply Complex.ext <;> simp <;> nlinarith [sqrt3_sq]
  rw [e, arg_mul_cos_add_sin_mul_I (by positivity)]
  constructor <;> linarith [Real.pi_pos]

lemma Abds_ne_zero : Abds B ≠ 0 := by
  intro h
  have := norm_Abds hB
  rw [h, norm_zero] at this
  have : 0 < 2 * √3 * (Real.pi / psi B) := by have := t_pos hB; positivity
  linarith

/-- **`𝔄 = t(w₁ + 2w₃)` satisfies condition (11).** -/
theorem bds_admissible : BdsAdmissible (Abds B) := by
  refine ⟨by rw [arg_Abds hB]; positivity, by rw [arg_Abds hB], ?_⟩
  rw [arg_Abds hB, show 2 * Real.pi / 3 - Real.pi / 6 = Real.pi / 2 by ring, Real.sin_pi_div_two,
    div_one, norm_Abds hB]
  have h3 : 0 < √3 := by positivity
  nlinarith [one_lt_t hB]

omit hB in
theorem Abds_eq : Abds B = ((Real.pi / psi B : ℝ) : ℂ) * (w1 + 2 * w3) := by
  unfold Abds w1 w3; congr 1; apply Complex.ext <;> simp <;> ring

/-- `|𝔄| κ(p,q)/𝔄 = √3 q − (2p + q) i`. -/
lemma scaled_kappa (p q : ℤ) :
    (‖Abds B‖ : ℂ) * kappa p q / Abds B = ⟨√3 * q, -(2 * p + q)⟩ := by
  rw [div_eq_iff (Abds_ne_zero hB), norm_Abds hB, Abds]
  have h3 := sqrt3_sq
  apply Complex.ext <;> simp [kappa] <;> ring_nf <;> rw [h3] <;> ring

/-- **`Λ(κ(p,q)) = ℒ(p,q)`**: BDS's map with `μ = 0`, `ν = √3 log B/ψ` is our lattice
logarithm `ℒ(p,q) = 2p log B + q(log B + iψ)` of Proposition A 5.7. -/
theorem lambda_kappa (p q : ℤ) : bdsLambda (Abds B) 0 (nuB B) (kappa p q) = Lq B p q := by
  have hψ := (psi_mem_Ioo hB).1
  have h3 : 0 < √3 := by positivity
  have h33 := sqrt3_sq
  unfold bdsLambda
  rw [scaled_kappa hB, norm_Abds hB]
  have hden : bdsPhi 0 (nuB B) ((2 * √3 * (Real.pi / psi B) : ℝ) : ℂ) =
      ((2 * √3 * (Real.pi / psi B) : ℝ) : ℂ) := by
    apply Complex.ext <;> simp [bdsPhi]
  rw [hden]
  have hne : ((2 * √3 * (Real.pi / psi B) : ℝ) : ℂ) ≠ 0 :=
    ofReal_ne_zero.2 (by have := t_pos hB; positivity)
  rw [div_eq_iff hne]
  unfold Lq bdsPhi nuB
  apply Complex.ext <;> simp <;> field_simp
  ring_nf

/-- `E(κ(p,q)) = B^{2p} β^q`. -/
theorem bdsE_kappa (p q : ℤ) :
    bdsE (Abds B) 0 (nuB B) (kappa p q) = (B : ℂ) ^ (2 * p) * beta B (psi B) ^ q := by
  rw [bdsE, lambda_kappa hB, exp_Lq hB]

/-- **The centers.** The similarity `z ↦ (z − X)/(−X)` maps the center of `K(p,q)` to
`E(κ(p,q))`. -/
theorem center_eq_bdsE (p q : ℤ) :
    (zc B (psi B) p q - X B) / (-(X B : ℂ)) = bdsE (Abds B) 0 (nuB B) (kappa p q) := by
  have hX : (X B : ℂ) ≠ 0 := ofReal_ne_zero.2 (X_ne_zero hB)
  rw [div_eq_iff (neg_ne_zero.2 hX), zc_Lq hB, bdsE, lambda_kappa hB]
  ring

/-- **The radii.** `r(p,q) = |E(κ(p,q))|`, so the normalized circle has radius `|E(κ)|/|X|`. -/
theorem rad_eq_norm_bdsE (p q : ℤ) : rad B p q = ‖bdsE (Abds B) 0 (nuB B) (kappa p q)‖ := by
  have hB0 : 0 < B := by linarith
  rw [bdsE_kappa hB, norm_mul, norm_zpow, norm_zpow, norm_real, Real.norm_eq_abs,
    abs_of_pos hB0, beta, norm_mul, norm_real, Real.norm_eq_abs, abs_of_pos hB0,
    norm_exp_ofReal_mul_I, mul_one, ← zpow_add₀ hB0.ne']
  rfl

omit hB in
/-- The normalized centers `w(p,q) = (z(p,q) − X)/(−X)`. -/
lemma wn_sub (p q p' q' : ℤ) :
    ‖(zc B (psi B) p q - X B) / (-(X B : ℂ)) - (zc B (psi B) p' q' - X B) / (-(X B : ℂ))‖ =
      ‖zc B (psi B) p q - zc B (psi B) p' q'‖ / |X B| := by
  rw [← sub_div, norm_div, norm_neg, norm_real, Real.norm_eq_abs]
  congr 2; ring

/-- **The pair `(0, √3 log B/ψ)` has all the properties of BDS Lemma 3** for `𝔄 = t(3 + √3 i)`. -/
theorem bds_lemma3 : BdsLemma3 (Abds B) 0 (nuB B) := by
  have hB0 : 0 < B := by linarith
  have hψ := psi_mem_Ioo hB
  have hX : 0 < |X B| := abs_pos.2 (X_ne_zero hB)
  obtain ⟨k1, k2, k3⟩ := kappa_w
  -- the three vertices
  have e1 : bdsE (Abds B) 0 (nuB B) w1 = ((B ^ 2 : ℝ) : ℂ) := by
    rw [← k1, bdsE_kappa hB]; push_cast; simp
  have e2 : bdsE (Abds B) 0 (nuB B) 2 = ((B : ℝ) : ℂ) * exp ((psi B : ℝ) * I) := by
    rw [← k2, bdsE_kappa hB, beta]; simp
  have e3 : bdsE (Abds B) 0 (nuB B) w3 = ((B⁻¹ : ℝ) : ℂ) * exp ((psi B : ℝ) * I) := by
    rw [← k3, bdsE_kappa hB, beta]
    have : (B : ℂ) ≠ 0 := ofReal_ne_zero.2 hB0.ne'
    push_cast; field_simp
  -- `0 < ν`
  have hν : 0 < nuB B := by
    unfold nuB
    exact div_pos (mul_pos (by positivity) (Real.log_pos hB)) hψ.1
  -- orientation, from that of `D_B`
  have hX0 : (X B : ℂ) ≠ 0 := ofReal_ne_zero.2 (X_ne_zero hB)
  have Wf : ∀ p q, bdsE (Abds B) 0 (nuB B) (kappa p q) =
      (-(X B : ℂ))⁻¹ * zc B (psi B) p q + 1 := by
    intro p q; rw [← center_eq_bdsE hB]; field_simp; ring
  have hk00 : (1 : ℂ) = bdsE (Abds B) 0 (nuB B) (kappa 0 0) := by rw [bdsE_kappa hB]; simp
  have hcfg := zc_isConfig hB
  have hor1 : 0 < orient 1 (bdsE (Abds B) 0 (nuB B) w1) (bdsE (Abds B) 0 (nuB B) 2) := by
    rw [hk00, ← k1, ← k2, Wf, Wf, Wf, orient_mul_add]
    have := hcfg.up 0 0
    norm_num at this
    exact mul_pos (pow_pos (norm_pos_iff.2 (inv_ne_zero (neg_ne_zero.2 hX0))) 2) this
  have hor2 : 0 < orient 1 (bdsE (Abds B) 0 (nuB B) 2) (bdsE (Abds B) 0 (nuB B) w3) := by
    rw [hk00, ← k2, ← k3, Wf, Wf, Wf, orient_mul_add]
    have := hcfg.down 0 0
    norm_num at this
    exact mul_pos (pow_pos (norm_pos_iff.2 (inv_ne_zero (neg_ne_zero.2 hX0))) 2) this
  refine ⟨hν, ?_, ?_, ?_⟩
  · -- `Im Λ(w_j) ∈ [0, π)`
    intro w hw
    rcases hw with rfl | rfl | rfl
    · rw [← k1, lambda_kappa hB]; simp [Lq]; exact Real.pi_pos
    · rw [← k2, lambda_kappa hB]; simp [Lq]; exact ⟨hψ.1.le, hψ.2⟩
    · rw [← k3, lambda_kappa hB]; simp [Lq]; exact ⟨hψ.1.le, hψ.2⟩
  · -- cell continuation, from the tangencies of `D_B`
    have hc := zc_isConfig hB
    have w00 : (1 : ℂ) = (zc B (psi B) 0 0 - X B) / (-(X B : ℂ)) := by
      rw [center_eq_bdsE hB, bdsE_kappa hB]; simp
    have W : ∀ p q, bdsE (Abds B) 0 (nuB B) (kappa p q) =
        (zc B (psi B) p q - X B) / (-(X B : ℂ)) := fun p q => (center_eq_bdsE hB p q).symm
    refine ⟨rad B 0 0 / |X B|, rad B 1 0 / |X B|, rad B 0 1 / |X B|, rad B (-1) 1 / |X B|,
      by unfold rad; positivity, by unfold rad; positivity, by unfold rad; positivity,
      by unfold rad; positivity, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [← k1, W, w00, wn_sub, show (1 : ℤ) = 0 + 1 by norm_num, hc.t10 0 0]; ring
    · rw [← k2, W, w00, wn_sub, show (1 : ℤ) = 0 + 1 by norm_num, hc.t01 0 0]; ring
    · rw [← k1, ← k2, W, W, wn_sub]
      have := hc.tm11 1 0
      norm_num at this ⊢
      rw [this]; ring
    · rw [← k3, W, w00, wn_sub]
      have := hc.tm11 0 0
      norm_num at this ⊢
      rw [this]; ring
    · rw [← k2, ← k3, W, W, wn_sub]
      have := hc.t10 (-1) 1
      norm_num at this ⊢
      rw [this]; ring
    · have key : (B : ℝ) ^ (2 * 0 + 0 : ℤ) * B ^ (2 * 0 + 1 : ℤ) =
          B ^ (2 * 1 + 0 : ℤ) * B ^ (2 * (-1) + 1 : ℤ) := by
        rw [← zpow_add₀ hB0.ne', ← zpow_add₀ hB0.ne']; norm_num
      unfold rad
      rw [div_mul_div_comm, div_mul_div_comm, key]
    · rw [← k1, ← rad_eq_norm_bdsE hB, show rad B 0 0 = 1 by simp [rad]]; ring
    · rw [← k2, ← rad_eq_norm_bdsE hB, show rad B 0 0 = 1 by simp [rad]]; ring
    · rw [← k3, ← rad_eq_norm_bdsE hB, show rad B 0 0 = 1 by simp [rad]]; ring
  · -- normalizations (3) and (8)
    rw [e1, e2] at hor1
    rw [e2, e3] at hor2
    rw [e1, e2, e3]
    have hB2 : 1 < B ^ 2 := by nlinarith
    have harg : ∀ r : ℝ, 0 < r → arg ((r : ℂ) * exp ((psi B : ℝ) * I)) = psi B := by
      intro r hr
      rw [arg_real_mul _ hr, exp_mul_I, arg_cos_add_sin_mul_I ⟨by linarith [hψ.1, Real.pi_pos],
        hψ.2.le⟩]
    have hn : ∀ r : ℝ, 0 < r → ‖(r : ℂ) * exp ((psi B : ℝ) * I)‖ = r := by
      intro r hr
      rw [norm_mul, norm_real, Real.norm_eq_abs, abs_of_pos hr, norm_exp_ofReal_mul_I, mul_one]
    have hn1 : ‖((B ^ 2 : ℝ) : ℂ)‖ = B ^ 2 := by
      rw [norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    have ha1 : arg ((B ^ 2 : ℝ) : ℂ) = 0 := arg_ofReal_of_nonneg (by positivity)
    refine ⟨?_, by rw [hn1]; linarith, by rw [hn1]; exact hB2, by rw [hn B hB0]; linarith,
      by rw [ha1], by rw [ha1, harg _ (inv_pos.2 hB0)]; exact hψ.1.le,
      by rw [harg _ (inv_pos.2 hB0), harg _ hB0], by rw [harg _ hB0]; exact hψ.2, hor1, hor2⟩
    have : (B : ℂ) ≠ 0 := ofReal_ne_zero.2 hB0.ne'
    push_cast; field_simp

/-- **Theorem A 7.5, identification.** For `B > 1`, `t = π/ψ(B)`, `𝔄 = t(w₁ + 2w₃)`:
`𝔄` satisfies BDS (11); the pair `(μ, ν) = (0, √3 log B/ψ)` has all properties of BDS Lemma 3;
`κ` maps `ℤ²` onto `H`; and the similarity `z ↦ (z − X)/(−X)` carries `K(p,q)` to the circle
with center `E(κ(p,q))` and radius `|E(κ(p,q))|/|X|`. -/
theorem bds_identification :
    Abds B = ((Real.pi / psi B : ℝ) : ℂ) * (w1 + 2 * w3) ∧ arg (Abds B) = Real.pi / 6 ∧
      BdsAdmissible (Abds B) ∧ BdsLemma3 (Abds B) 0 (nuB B) ∧
      (∀ a b : ℤ, ∃! u : ℤ × ℤ, kappa u.1 u.2 = a * w1 + b * w3) ∧
      ∀ p q : ℤ, (zc B (psi B) p q - X B) / (-(X B : ℂ)) = bdsE (Abds B) 0 (nuB B) (kappa p q) ∧
        rad B p q / |X B| = ‖bdsE (Abds B) 0 (nuB B) (kappa p q)‖ / |X B| :=
  ⟨Abds_eq, arg_Abds hB, bds_admissible hB, bds_lemma3 hB, kappa_bij,
    fun p q => ⟨center_eq_bdsE hB p q, by rw [rad_eq_norm_bdsE hB]⟩⟩

end DB

