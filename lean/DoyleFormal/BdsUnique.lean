import DoyleFormal.BdsIdent
import DoyleFormal.Consequences
import DoyleFormal.OneShapeConfig

/-!
# Uniqueness in Lemma 3 of Beardon–Dubejko–Stephenson on the ray `arg 𝔄 = π/6`

`bds_lemma3_unique`: for `𝔄 = t(3 + √3 i)`, `t = π/ψ(B)`, `B > 1`, the only pair `(μ, ν)` with
the properties of BDS Lemma 3 (`BdsLemma3`) is `(0, √3 log B/ψ)`. With `bds_lemma3` this
completes the identification `D_B = P_𝔄` of Theorem A 7.5 without citing BDS: `P_𝔄` is, by their
definition, the packing generated by the quadrilateral of this unique pair.

The proof does not follow BDS §8. Write `a = Λ(w₁)`, `b = Λ(w₂)`. The period `Λ(𝔄) = 2πi` and
`𝔄 = t(2w₂ − w₁)` give `Re a = 2 Re b`, so the radii `R₀|z|` of the configuration
`W(p,q) = e^{pa + qb}/R₀` generated by the quadrilateral are `B'^{2p+q}`, `B' = e^{Re b}`: it is a
member of the quadratic family. By rigidity (`prop_5_4`) it is a similar image of `D_{B'}`, so
`e^a = B'²` and `e^b = B' e^{iψ(B')}`; the normalizations `Im Λ(w_j) ∈ [0, π)` then give `Im a = 0`,
`Im b = ψ(B')`, the period gives `ψ(B') = π/t = ψ(B)`, hence `B' = B`, and evaluating `Λ(w₁)`
gives `μ = 0`, `ν = √3 log B/ψ`.
-/

namespace DoyleFormal

open Complex

lemma bdsPhi_smul (μ ν r : ℝ) (z : ℂ) : bdsPhi μ ν ((r : ℂ) * z) = (r : ℂ) * bdsPhi μ ν z := by
  apply Complex.ext <;> simp [bdsPhi] <;> ring

/-- `Λ` is `ℝ`-linear. -/
lemma bdsLambda_smul (A : ℂ) (μ ν r : ℝ) (z : ℂ) :
    bdsLambda A μ ν ((r : ℂ) * z) = (r : ℂ) * bdsLambda A μ ν z := by
  unfold bdsLambda
  rw [show (‖A‖ : ℂ) * ((r : ℂ) * z) / A = (r : ℂ) * ((‖A‖ : ℂ) * z / A) by ring, bdsPhi_smul]
  ring

lemma w3_eq : w3 = 2 + ((-1 : ℝ) : ℂ) * w1 := by
  apply Complex.ext <;> simp [w1, w3] <;> norm_num

/-- `exp z = exp w` for reals: the imaginary parts differ by a multiple of `2π`. -/
lemma im_eq_of_exp_eq {z w : ℂ} (h : exp z = exp w) : ∃ n : ℤ, z.im = w.im + n * (2 * Real.pi) := by
  obtain ⟨n, hn⟩ := Complex.exp_eq_exp_iff_exists_int.1 h
  refine ⟨n, ?_⟩
  have := congrArg Complex.im hn
  simpa using this

/-- An integer multiple of `2π` in `(−π, π)` is `0`. -/
lemma int_two_pi_eq_zero {n : ℤ} (h1 : -Real.pi < n * (2 * Real.pi)) (h2 : n * (2 * Real.pi) < Real.pi) :
    n = 0 := by
  have hp := Real.pi_pos
  have a1 : (-1 : ℝ) < 2 * n := by nlinarith
  have a2 : (2 * n : ℝ) < 1 := by nlinarith
  have b1 : (-1 : ℤ) < 2 * n := by exact_mod_cast a1
  have b2 : 2 * n < (1 : ℤ) := by exact_mod_cast a2
  omega

set_option maxHeartbeats 1000000 in
/-- **Uniqueness in BDS Lemma 3 on the ray `arg 𝔄 = π/6`.** -/
theorem bds_lemma3_unique {B : ℝ} (hB : 1 < B) {μ ν : ℝ} (h : BdsLemma3 (Abds B) μ ν) :
    μ = 0 ∧ ν = nuB B := by
  have hB0 : 0 < B := by linarith
  have hψ := psi_mem_Ioo hB
  have ht := t_pos hB
  have hpi := Real.pi_pos
  obtain ⟨a, ha⟩ : ∃ a, bdsLambda (Abds B) μ ν w1 = a := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b, bdsLambda (Abds B) μ ν 2 = b := ⟨_, rfl⟩
  have hL3 : bdsLambda (Abds B) μ ν w3 = b - a := by
    rw [congrArg (bdsLambda (Abds B) μ ν) w3_eq, bdsLambda_add, bdsLambda_smul, ha, hb]
    push_cast; ring
  -- the period: `t(2b − a) = 2πi`
  have hA' : Abds B = ((Real.pi / psi B : ℝ) : ℂ) * (((-1 : ℝ) : ℂ) * w1 + ((2 : ℝ) : ℂ) * 2) := by
    unfold Abds; congr 1; apply Complex.ext <;> simp [w1] <;> norm_num
  have hper : ((Real.pi / psi B : ℝ) : ℂ) * (-a + 2 * b) = 2 * Real.pi * I := by
    have e := bdsLambda_self (Abds_ne_zero hB) μ ν
    rw [congrArg (bdsLambda (Abds B) μ ν) hA', bdsLambda_smul, bdsLambda_add, bdsLambda_smul,
      bdsLambda_smul, ha, hb] at e
    rw [← e]; push_cast; ring
  have hre : a.re = 2 * b.re := by
    have e := congrArg Complex.re hper
    simp at e
    rcases e with e | e
    · first | linarith | exact absurd e hψ.1.ne'
    · first | linarith | exact absurd e hψ.1.ne'
  have him : Real.pi / psi B * (-a.im + 2 * b.im) = 2 * Real.pi := by
    have e := congrArg Complex.im hper
    simpa using e
  -- unpack the hypotheses
  obtain ⟨hν, hIm, hcq, hnorm⟩ := h
  obtain ⟨R0, R1, R2, R3, hR0, hR1, hR2, hR3, d10, d20, d21, d30, d23, hprod, p1, p2, p3⟩ := hcq
  obtain ⟨n1, n2, hz1, n4, n5, n6, n7, n8, or1, or2⟩ := hnorm
  simp only [bdsE, ha, hb, hL3] at d10 d20 d30 p1 p2 p3 hz1 or1 or2
  have hIa : 0 ≤ a.im ∧ a.im < Real.pi := by have := hIm w1 (by simp); rwa [ha] at this
  have hIb : 0 ≤ b.im ∧ b.im < Real.pi := by have := hIm 2 (by simp); rwa [hb] at this
  -- `B' = e^{Re b}`
  set B' := Real.exp b.re with hB'def
  have hB'0 : 0 < B' := Real.exp_pos _
  have na : ‖exp a‖ = B' ^ 2 := by
    rw [Complex.norm_exp, hre, hB'def, ← Real.exp_nat_mul]; push_cast; ring_nf
  have nb : ‖exp b‖ = B' := by rw [Complex.norm_exp]
  have nab : ‖exp (b - a)‖ = B'⁻¹ := by
    rw [Complex.norm_exp, sub_re, hre, hB'def, ← Real.exp_neg]; ring_nf
  have hB'1 : 1 < B' := by
    rw [na] at hz1; nlinarith
  have hea : exp a ≠ 0 := exp_ne_zero a
  have heb : exp b ≠ 0 := exp_ne_zero b
  -- the configuration generated by the quadrilateral
  let W : ℤ → ℤ → ℂ := fun p q => ((R0⁻¹ : ℝ) : ℂ) * (exp a ^ p * exp b ^ q)
  have nW : ∀ p q, ‖W p q‖ = R0⁻¹ * B' ^ (2 * p + q) := by
    intro p q
    simp only [W, norm_mul, norm_zpow, na, nb, norm_real, Real.norm_eq_abs,
      abs_of_pos (inv_pos.2 hR0)]
    rw [← zpow_natCast, ← zpow_mul, ← zpow_add₀ hB'0.ne']
    push_cast; ring_nf
  have Wne : ∀ p q, W p q ≠ 0 := by
    intro p q
    simp only [W]
    exact mul_ne_zero (ofReal_ne_zero.2 (inv_ne_zero hR0.ne'))
      (mul_ne_zero (zpow_ne_zero _ hea) (zpow_ne_zero _ heb))
  have W10 : ∀ p q, W (p + 1) q = W p q * exp a := by
    intro p q; simp only [W]; rw [zpow_add_one₀ hea]; ring
  have W01 : ∀ p q, W p (q + 1) = W p q * exp b := by
    intro p q; simp only [W]; rw [zpow_add_one₀ heb]; ring
  have Wm11 : ∀ p q, W (p - 1) (q + 1) = W p q * exp (b - a) := by
    intro p q; simp only [W]; rw [zpow_sub_one₀ hea, zpow_add_one₀ heb, exp_sub]; field_simp
  have r10 : ∀ p q, rad B' (p + 1) q = rad B' p q * B' ^ 2 := by
    intro p q; unfold rad
    rw [show 2 * (p + 1) + q = (2 * p + q) + 2 by ring, zpow_add₀ hB'0.ne']; norm_num
  have r01 : ∀ p q, rad B' p (q + 1) = rad B' p q * B' := by
    intro p q; unfold rad
    rw [show 2 * p + (q + 1) = (2 * p + q) + 1 by ring, zpow_add₀ hB'0.ne', zpow_one]
  have rm11 : ∀ p q, rad B' (p - 1) (q + 1) = rad B' p q * B'⁻¹ := by
    intro p q; unfold rad
    rw [show 2 * (p - 1) + (q + 1) = (2 * p + q) + (-1) by ring, zpow_add₀ hB'0.ne', zpow_neg_one]
  have nW' : ∀ p q, ‖W p q‖ = R0⁻¹ * rad B' p q := fun p q => by rw [nW]; rfl
  have hcfg : IsConfig (rad B') W := by
    refine ⟨fun p q => ?_, fun p q => ?_, fun p q => ?_, fun p q => ?_, fun p q => ?_⟩
    · rw [W10, show W p q * exp a - W p q = W p q * (exp a - 1) by ring, norm_mul, nW', d10, p1,
        na, r10]
      field_simp
    · rw [W01, show W p q * exp b - W p q = W p q * (exp b - 1) by ring, norm_mul, nW', d20, p2,
        nb, r01]
      field_simp
    · rw [Wm11, show W p q * exp (b - a) - W p q = W p q * (exp (b - a) - 1) by ring, norm_mul,
        nW', d30, p3, nab, rm11]
      field_simp
    · rw [W10, W01]
      have := orient_mul_add (W p q) 0 1 (exp a) (exp b)
      simp only [mul_one, add_zero] at this
      rw [mul_comm (W p q) (exp a), mul_comm (W p q) (exp b)] at this ⊢
      rw [show exp a * W p q = W p q * exp a by ring, show exp b * W p q = W p q * exp b by ring]
        at this ⊢
      rw [this]
      exact mul_pos (pow_pos (norm_pos_iff.2 (Wne p q)) 2) or1
    · rw [W01, Wm11]
      have := orient_mul_add (W p q) 0 1 (exp b) (exp (b - a))
      simp only [mul_one, add_zero] at this
      rw [this]
      exact mul_pos (pow_pos (norm_pos_iff.2 (Wne p q)) 2) or2
  -- normalize and apply rigidity
  have d00 : ‖W 1 0 - W 0 0‖ = 1 + B' ^ 2 := by
    have := hcfg.t10 0 0
    norm_num at this
    rw [this]; unfold rad; norm_num; ring
  have hd0 : W 1 0 - W 0 0 ≠ 0 := by
    intro h0; rw [h0, norm_zero] at d00; nlinarith
  set c : ℂ := ((1 + B' ^ 2 : ℝ) : ℂ) / (W 1 0 - W 0 0) with hcdef
  have hc1 : ‖c‖ = 1 := by
    rw [hcdef, norm_div, d00, norm_real, Real.norm_eq_abs, abs_of_pos (by positivity),
      div_self (by positivity)]
  have hc0 : c ≠ 0 := by intro h0; rw [h0, norm_zero] at hc1; norm_num at hc1
  have hcfg' := hcfg.affine hc0 (-(c * W 0 0))
  rw [hc1] at hcfg'
  simp only [one_mul] at hcfg'
  have hW' := prop_5_4 hB'1 hcfg' (by ring) (by rw [hcdef]; field_simp; ring)
  -- multipliers
  have key : ∀ p q, c * W p q + -(c * W 0 0) = zc B' (psi B') p q := hW'
  have hX' : (X B' : ℂ) ≠ 0 := ofReal_ne_zero.2 (X_ne_zero hB'1)
  have z00 := zc_zero_zero B' (psi B')
  have z10 := zc_one_zero (psi B') hB'1
  have hs0 : ((1 + B' ^ 2 : ℝ) : ℂ) ≠ 0 := ofReal_ne_zero.2 (by positivity)
  -- along `(0,1)`: `V(p,q+1) = e^b V(p,q) + K`, and `S_map`
  have relS : ∀ p q, zc B' (psi B') p (q + 1) =
      exp b * zc B' (psi B') p q + c * W 0 0 * (exp b - 1) := by
    intro p q; rw [← key, ← key, W01]; ring
  have relT : ∀ p q, zc B' (psi B') (p + 1) q =
      exp a * zc B' (psi B') p q + c * W 0 0 * (exp a - 1) := by
    intro p q; rw [← key, ← key, W10]; ring
  have eb : exp b = beta B' (psi B') := by
    have r10 := relS 1 0
    have s10 := S_map (psi B') hB'0.ne' 1 0
    have r00 := relS 0 0
    have s00 := S_map (psi B') hB'0.ne' 0 0
    rw [z10] at r10 s10
    rw [z00] at r00 s00
    have : (exp b - beta B' (psi B')) * ((1 + B' ^ 2 : ℝ) : ℂ) = 0 := by
      linear_combination (-1 : ℂ) * r10 + (-1 : ℂ) * s10 + r00 + s00
    exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_right hs0)
  have z01 : zc B' (psi B') 0 1 = X B' * (1 - beta B' (psi B')) := by
    have := S_map (psi B') hB'0.ne' 0 0
    rw [z00] at this
    rw [show (1 : ℤ) = 0 + 1 by norm_num, ← this]; ring
  have hβ1 : beta B' (psi B') ≠ 1 := by
    intro h1
    have := congrArg (‖·‖) h1
    simp only [beta, norm_mul, norm_real, Real.norm_eq_abs, abs_of_pos hB'0,
      norm_exp_ofReal_mul_I, mul_one, norm_one] at this
    linarith
  have hz01 : zc B' (psi B') 0 1 ≠ 0 := by
    rw [z01]; exact mul_ne_zero hX' (sub_ne_zero.2 (Ne.symm hβ1))
  have ea : exp a = (B' : ℂ) ^ 2 := by
    have r01 := relT 0 1
    have t01 := T_map (psi B') hB'0.ne' 0 1
    have r00 := relT 0 0
    have t00 := T_map (psi B') hB'0.ne' 0 0
    rw [z00] at r00 t00
    have : (exp a - (B' : ℂ) ^ 2) * zc B' (psi B') 0 1 = 0 := by
      linear_combination (-1 : ℂ) * r01 + (-1 : ℂ) * t01 + r00 + t00
    exact sub_eq_zero.1 ((mul_eq_zero.1 this).resolve_right hz01)
  -- imaginary parts
  have ha0 : a.im = 0 := by
    have e : exp a = exp (((2 * Real.log B' : ℝ)) : ℂ) := by
      rw [ea, ← ofReal_exp, show 2 * Real.log B' = Real.log (B' ^ 2) by
        rw [Real.log_pow]; push_cast; ring, Real.exp_log (by positivity)]
      push_cast; ring
    obtain ⟨n, hn⟩ := im_eq_of_exp_eq e
    simp at hn
    have : n = 0 := int_two_pi_eq_zero (by linarith [hIa.1]) (by linarith [hIa.2])
    rw [hn, this]; simp
  have hb0 : b.im = psi B' := by
    have hψ' := psi_mem_Ioo hB'1
    have e : exp b = exp ((Real.log B' : ℂ) + (psi B' : ℂ) * I) := by
      rw [eb, beta, exp_add, ← ofReal_exp, Real.exp_log hB'0]
    obtain ⟨n, hn⟩ := im_eq_of_exp_eq e
    simp at hn
    have : n = 0 := int_two_pi_eq_zero (by linarith [hIb.1, hψ'.2])
      (by linarith [hIb.2, hψ'.1])
    rw [hn, this]; simp
  -- `ψ(B') = ψ(B)`, so `B' = B`
  have hψeq : psi B' = psi B := by
    rw [ha0, hb0, div_mul_eq_mul_div, div_eq_iff hψ.1.ne'] at him
    have h2 : Real.pi * (psi B' - psi B) = 0 := by linarith
    rcases mul_eq_zero.1 h2 with h3 | h3
    · linarith
    · linarith
  have hBB : B' = B := psi_strictMonoOn.injOn (Set.mem_Ioi.2 hB'1) (Set.mem_Ioi.2 hB) hψeq
  have hlog : b.re = Real.log B := by rw [← hBB, hB'def, Real.log_exp]
  -- evaluate `Λ(w₁)`
  have hAn := norm_Abds hB
  have hApos : 0 < ‖Abds B‖ := by rw [hAn]; positivity
  have hΦ2 : bdsPhi μ ν (‖Abds B‖ : ℂ) = ⟨‖Abds B‖, μ * ‖Abds B‖⟩ := by
    apply Complex.ext <;> simp [bdsPhi]
  have hP : bdsPhi μ ν (‖Abds B‖ : ℂ) ≠ 0 := by
    rw [hΦ2]; intro h0
    have := congrArg Complex.re h0
    simp only [zero_re] at this
    linarith
  have hsc : (‖Abds B‖ : ℂ) * w1 / Abds B = ⟨0, -2⟩ := by
    rw [← kappa_w.1, scaled_kappa hB]; apply Complex.ext <;> simp
  have hΦ1 : bdsPhi μ ν ⟨0, -2⟩ = ⟨0, -2 * ν⟩ := by apply Complex.ext <;> simp [bdsPhi]; ring
  have ha' : a = ((2 * Real.log B : ℝ) : ℂ) := Complex.ext (by simp [hre, hlog]) (by simp [ha0])
  rw [bdsLambda, hsc, div_eq_iff hP, hΦ1, hΦ2, ha'] at ha
  have hlB : 0 < Real.log B := Real.log_pos hB
  have ere : 2 * Real.pi * (2 * ν) = 2 * Real.log B * ‖Abds B‖ := by
    have := congrArg Complex.re ha
    simp at this
    linarith
  have hμ : μ = 0 := by
    have := congrArg Complex.im ha
    simp at this
    rcases this with (h1 | h1 | h1) | h1 | h1
    · linarith
    · linarith
    · linarith
    · exact h1
    · exact absurd h1 (Abds_ne_zero hB)
  refine ⟨hμ, ?_⟩
  unfold nuB
  rw [hAn] at ere
  have hψ0 : psi B ≠ 0 := hψ.1.ne'
  rw [eq_div_iff hψ0]
  have h4 : 4 * Real.pi * (ν * psi B) = 4 * Real.pi * (√3 * Real.log B) := by
    calc 4 * Real.pi * (ν * psi B) = (2 * Real.pi * (2 * ν)) * psi B := by ring
      _ = (2 * Real.log B * (2 * √3 * (Real.pi / psi B))) * psi B := by rw [ere]
      _ = 4 * Real.pi * (√3 * Real.log B) := by field_simp; norm_num
  have := mul_left_cancel₀ (by positivity : (4 * Real.pi : ℝ) ≠ 0) h4
  linarith

/-- **Theorem A 7.5, identification with BDS, in full.** For `𝔄 = t(w₁ + 2w₃)` there is exactly one
pair `(μ, ν)` with the properties of BDS Lemma 3, namely `(0, √3 log B/ψ)`; so the packing `P_𝔄`
of BDS is generated by the quadrilateral `1, B², Be^{iψ}, e^{iψ}/B`, and its centers `E_𝔄(H)` are
the normalized centers of `D_B` (`bds_identification`). -/
theorem bds_unique_pair {B : ℝ} (hB : 1 < B) :
    ∃! μν : ℝ × ℝ, BdsLemma3 (Abds B) μν.1 μν.2 :=
  ⟨(0, nuB B), bds_lemma3 hB, fun ⟨μ, ν⟩ h => by
    obtain ⟨h1, h2⟩ := bds_lemma3_unique hB h
    exact Prod.ext h1 h2⟩

end DoyleFormal
